# Copy this file to ~/.config/pascal-frankenstein-llm/qwen.env and edit it.

# Absolute path to a GGUF model outside this repository.
MODEL=

# Optional API key. Leave empty for localhost-only development.
API_KEY=

MODEL_ALIAS=qwen35b-local
HOST=127.0.0.1
PORT=8001
CONTEXT_SIZE=65536
MAX_TOKENS=32768
KV_TYPE=q8_0
MOE_CACHE_SLOTS=160,108
SPEC_DRAFT_N_MAX=2
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20

# Keep these aligned with the Pascal dual-GPU setup unless you have a reason
# to change them.
GPU_LAYERS=99
MOE_CPU_LAYERS=33
TENSOR_SPLIT=10,7
BATCH_SIZE=512
UBATCH_SIZE=512
REASONING=on
REASONING_PRESERVE=1
NO_CONTEXT_SHIFT=1
JINJA=1

# The installer points this at the packaged profile by default.
MOE_CACHE_PROFILE=
